    {
      "title": "Live readings",
      "height": "280px",
      "showTitle": true,
      "collapse": false,
      "panels": [
        {
          "id": 1,
          "title": "Temperature",
          "type": "graph",
          "datasource": "industrial_iot",
          "span": 4,
          "targets": [
            {
              "refId": "A",
              "policy": "default",
              "measurement": "sensor_readings",
              "resultFormat": "time_series",
              "select": [
                [
                  {
                    "type": "field",
                    "params": [
                      "temperature"
                    ]
                  },
                  {
                    "type": "mean",
                    "params": []
                  }
                ]
              ],
              "groupBy": [
                {
                  "type": "time",
                  "params": [
                    "$__interval"
                  ]
                },
                {
                  "type": "tag",
                  "params": [
                    "sensor"
                  ]
                },
                {
                  "type": "fill",
                  "params": [
                    "null"
                  ]
                }
              ],
              "tags": [
                {
                  "key": "zone",
                  "operator": "=~",
                  "value": "/^$zone$/"
                }
              ],
              "orderByTime": "ASC",
              "alias": "$tag_sensor"
            }
          ],
          "lines": true,
          "linewidth": 1,
          "fill": 1,
          "points": false,
          "nullPointMode": "null",
          "legend": {
            "show": true,
            "values": false
          },
          "tooltip": {
            "shared": true,
            "sort": 0,
            "value_type": "individual"
          },
          "xaxis": {
            "mode": "time",
            "show": true
          },
          "yaxes": [
            {
              "format": "celsius",
              "show": true,
              "logBase": 1
