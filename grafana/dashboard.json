    "list": [
      {
        "name": "zone",
        "label": "Zone",
        "type": "query",
        "datasource": "industrial_iot",
        "query": "SHOW TAG VALUES FROM sensor_readings WITH KEY = \"zone\"",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "regex": "",
        "sort": 1,
        "hide": 0,
        "useTags": false,
        "current": {},
        "options": []
      }
    ]
  },
